POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://warehouse@localhost:5432/warehouse
LLM_PROVIDER=litellm
LITELLM_BASE_URL=http://host.docker.internal:8445/v1
LITELLM_API_KEY=replace-with-litellm-proxy-key
LITELLM_MODEL=hosted_vllm/gemma4-chat
# Ollama is temporarily disabled; kept here only for re-enabling later.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=nemotron-3-nano:4b
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4-flash
WORKSPACE_PATH=skills/warehouse_prod
SEED_ORDERS=50000
TPCDS_SCALE=10
TPCDS_DATA_PATH=.data/tpcds/sf10
TPCDS_TOOLKIT_PATH=.cache/tpcds-kit
EXPLORER_ROUNDS=3
EXPLORER_PROBES_PER_ROUND=3
BOOTSTRAP_ON_START=1
VERIFY_INTERVAL_HOURS=24
